{
  "schema": 1,
  "id": "main",
  "root": {
    "id": "root",
    "type": "split",
    "ratio": [
      50,
      50
    ],
    "responsive": "stack",
    "children": [
      {
        "id": "orders-list",
        "type": "list",
        "title": "Orders",
        "bind": "orders",
        "key": "id",
        "display": [
          "number",
          "customer",
          "status"
        ],
        "selection": "selected",
        "toolbar": [
          {
            "id": "new-customer",
            "bind": "newCustomer"
          },
          {
            "id": "add-row",
            "label": "Add order"
          },
          {
            "type": "separator"
          },
          {
            "id": "confirm-selected",
            "label": "Confirm selected"
          },
          {
            "type": "separator"
          },
          {
            "id": "delete-selected",
            "label": "Delete selected",
            "kind": "danger"
          }
        ]
      },
      {
        "id": "order-detail",
        "type": "detail",
        "title": "Order details",
        "controls": [
          "selectedOrder.number",
          "selectedOrder.customer",
          "selectedOrder.status"
        ]
      }
    ]
  }
}
