{
  "schema": 1,
  "id": "main",
  "root": {
    "id": "root",
    "type": "split",
    "ratio": [
      50,
      50
    ],
    "responsive": "stack",
    "children": [
      {
        "id": "orders-list",
        "type": "list",
        "title": {
          "package": "the8020/demo",
          "key": "program.orders",
          "fallback": "Orders"
        },
        "bind": "orders",
        "key": "id",
        "display": [
          "number",
          "customer",
          "status"
        ],
        "selection": "selected",
        "toolbar": [
          {
            "id": "new-customer",
            "bind": "newCustomer"
          },
          {
            "id": "add-row",
            "label": {
              "package": "the8020/demo",
              "key": "layouts.demo-master-detail.main.add-row.label",
              "fallback": "Add order"
            }
          },
          {
            "type": "separator"
          },
          {
            "id": "confirm-selected",
            "label": {
              "package": "the8020/demo",
              "key": "layouts.demo-master-detail.main.confirm-selected.label",
              "fallback": "Confirm selected"
            }
          },
          {
            "type": "separator"
          },
          {
            "id": "delete-selected",
            "label": {
              "package": "the8020/demo",
              "key": "layouts.demo-master-detail.main.delete-selected.label",
              "fallback": "Delete selected"
            },
            "kind": "danger"
          }
        ]
      },
      {
        "id": "order-detail",
        "type": "detail",
        "title": {
          "package": "the8020/demo",
          "key": "layouts.demo-master-detail.main.order-detail.title",
          "fallback": "Order details"
        },
        "controls": [
          "selectedOrder.number",
          "selectedOrder.customer",
          "selectedOrder.status"
        ]
      }
    ]
  }
}
