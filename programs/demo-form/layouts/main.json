{
  "schema": 1,
  "id": "main",
  "root": {
    "id": "root",
    "type": "stack",
    "children": [
      {
        "id": "form-section",
        "type": "section",
        "title": {
          "package": "the8020/demo",
          "key": "layouts.demo-form.main.form-section.title",
          "fallback": "Form fields"
        },
        "children": [
          {
            "id": "form-groups",
            "type": "grid",
            "columns": 2,
            "responsive": "stack",
            "children": [
              {
                "id": "account",
                "type": "field-group",
                "title": {
                  "package": "the8020/demo",
                  "key": "layouts.demo-responsive-fields.main.account-group.title",
                  "fallback": "Account"
                },
                "controls": [
                  "username",
                  "primary-email",
                  "confirmation-email",
                  "role"
                ]
              },
              {
                "id": "profile",
                "type": "field-group",
                "title": {
                  "package": "the8020/demo",
                  "key": "layouts.demo-form.main.profile.title",
                  "fallback": "Profile"
                },
                "controls": [
                  "biography",
                  "enabled"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "result-section",
        "type": "section",
        "title": {
          "package": "the8020/demo",
          "key": "layouts.demo-form.main.result-section.title",
          "fallback": "Result"
        },
        "children": [
          {
            "id": "result",
            "type": "field-group",
            "title": {
              "package": "the8020/demo",
              "key": "layouts.demo-form.main.result.title",
              "fallback": "Latest operation"
            },
            "controls": [
              "saveCount",
              "status"
            ]
          }
        ]
      },
      {
        "type": "section",
        "title": {
          "package": "the8020/demo",
          "key": "fields.code",
          "fallback": "Code"
        },
        "children": [
          {
            "type": "field-group",
            "title": {
              "package": "the8020/demo",
              "key": "layouts.demo-form.main.title.title",
              "fallback": "TypeScript"
            },
            "controls": [
              "source"
            ]
          }
        ]
      },
      {
        "id": "download-section",
        "type": "section",
        "title": {
          "package": "the8020/demo",
          "key": "layouts.demo-form.main.download-section.title",
          "fallback": "Downloads"
        },
        "children": [
          {
            "id": "downloads",
            "type": "field-group",
            "title": {
              "package": "the8020/demo",
              "key": "layouts.demo-form.main.downloads.title",
              "fallback": "Files and calculations"
            },
            "controls": [
              "downloadRows"
            ],
            "actions": [
              "download-file",
              "download-csv"
            ]
          }
        ]
      }
    ]
